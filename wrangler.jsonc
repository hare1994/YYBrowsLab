// Cloudflare Workers config: serves the static brow lab site from ./public, and counts anonymous usage events
// through src/worker.js (only the /e path reaches the script; every other request is served as a static file).
// Cloudflare builds and deploys this automatically on every push to main.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yybrowslab",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/e"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {"enabled": true, "invocation_logs": false}
  }
}
